+/*
+ * STMicro FTS (S7 edge). Commands are 1-4 byte strings; Linux
+ * fts_read_reg() sends them with a repeated start before the read, here
+ * (as for sec_ts above) a write with STOP, then the read. Same 10 retries.
+ */
+static bool
+ft_xfer(const uint8_t *cmd, unsigned clen, uint8_t *data, unsigned len)
+{
+	uint8_t c[4];
+
+	if (clen == 0 || clen > sizeof(c)) {
+		return false;
+	}
+	for (unsigned attempt = 0; attempt < 10; attempt++) {
+		if (attempt) {
+			ht_retries++;
+			delay(200);
+		}
+		for (unsigned i = 0; i < clen; i++) {
+			c[i] = cmd[i];
+		}
+		if (ht_message(false, c, clen) && (len == 0 || ht_message(true, data, len))) {
+			return true;
+		}
+	}
+	ht_lost++;
+	return false;
+}
+
+static bool
+ft_cmd(uint8_t cmd)
+{
+	return ft_xfer(&cmd, 1, NULL, 0);
+}
+
+/* fts_interrupt_set(INT_ENABLE): B6 00 1C 41. */
+static bool
+ft_int_enable(void)
+{
+	static const uint8_t cmd[4] = {0xb6, 0x00, 0x1c, 0x41};
+	return ft_xfer(cmd, sizeof(cmd), NULL, 0);
+}
+
+/* fts_init() after the firmware check: SLEEPOUT, SENSEON, FLUSH, INT on. */
+static bool
+ft_sense_on(bool calibrate)
+{
+	bool ok = ft_cmd(FTS_SLEEPOUT) && ft_cmd(FTS_SENSEON);
+	if (calibrate) {
+		ok = ok && ft_cmd(FTS_FORCECALIBRATION);
+	}
+	return ok && ft_cmd(FTS_FLUSHBUFFER) && ft_int_enable();
+}
+
+static bool
+ft_init(void)
+{
+	static const uint8_t reset[4] = {0xb6, 0x00, 0x23, 0x01};      /* fts_systemreset */
+	static const uint8_t chip_id[3] = {0xb6, 0x00, 0x07};           /* fts_read_chip_id */
+	uint8_t cmd = FTS_READ_ONE_EVENT, e[8] = {0}, v[7] = {0};
+	bool ready = false;
+
+	if (!ft_xfer(reset, sizeof(reset), NULL, 0)) {
+		printf("HEROLTE TOUCH: FTS: no ACK at 0x49 either\n");
+		return false;
+	}
+	ht_msleep(10);
+	/* fts_wait_for_ready(): pop events until CONTROLLER_READY (0x10). */
+	for (unsigned n = 0; n < 50 && !ready; n++) {
+		if (ft_xfer(&cmd, 1, e, sizeof(e)) && e[0] == FTS_EV_READY) {
+			ready = true;
+		} else {
+			ht_msleep(20);
+		}
+	}
+	printf("HEROLTE TOUCH: FTS %s: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    ready ? "ready" : "no READY event", e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+	if (ft_xfer(chip_id, sizeof(chip_id), v, sizeof(v))) {
+		/* Linux expects 39 80 (rev 1) or 39 6c (rev 2) in v[1], v[2]. */
+		printf("HEROLTE TOUCH: FTS chip id %02x %02x %02x %02x %02x %02x%s\n",
+		    v[1], v[2], v[3], v[4], v[5], v[6], v[1] == FTS_ID0 ? "" : " (unexpected; continuing)");
+	}
+	if (!ft_sense_on(true)) {
+		printf("HEROLTE TOUCH: FTS SENSEON sequence failed\n");
+		return false;
+	}
+	return true;
+}
+
+/* One 8-byte event; false when the FIFO is empty (event id 0). */
+static bool
+ft_event(unsigned *lines)
+{
+	uint8_t cmd = FTS_READ_ONE_EVENT, e[8] = {0};
+
+	if (!ft_xfer(&cmd, 1, e, sizeof(e)) || e[0] == 0) {
+		return false;
+	}
+	/* fts_event_handler_type_b(): pointer events carry the id in bits 7:4. */
+	unsigned id = e[0] & 0xfu;
+	if (id < FTS_EV_ENTER || id > FTS_EV_MOTION) {
+		if (*lines < 64) {
+			(*lines)++;
+			printf("HEROLTE TOUCH: FTS status %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+		}
+		if (e[0] == FTS_EV_READY) {
+			/* The controller reset itself: sense again, no recalibration. */
+			ht_release_all();
+			(void)ft_sense_on(false);
+		}
+		return true;
+	}
+	int tid = e[0] >> 4;
+	unsigned rx = e[1] | ((unsigned)(e[2] & 0xf) << 8);
+	unsigned ry = (e[2] >> 4) | ((unsigned)e[3] << 4);
+	if (tid >= HT_FINGERS) {
+		return true;
+	}
+	/* DTB stm,max_coords = <0xfff 0xfff>. */
+	int x = (int)(rx * 1440u / 4096u);
+	int y = (int)(ry * 2560u / 4096u);
+	if (*lines < 64 && id != FTS_EV_MOTION) {
+		(*lines)++;
+		printf("HEROLTE TOUCH: FTS id=%d event=%u raw=%u,%u -> %d,%d\n", tid, id, rx, ry, x, y);
+	}
+	if (id == FTS_EV_LEAVE) {
+		if (ht_down[tid]) {
+			ht_down[tid] = false;
+			sweet_hid_touch(tid, 0, ht_x[tid], ht_y[tid]);
+		}
+	} else {
+		if (id == FTS_EV_MOTION) {
+			ht_moves++;
+		}
+		ht_down[tid] = true;
+		ht_x[tid] = x;
+		ht_y[tid] = y;
+		sweet_hid_touch(tid, 1, x, y);
+	}
+	return true;
+}
