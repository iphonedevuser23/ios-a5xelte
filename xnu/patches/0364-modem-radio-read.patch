 static vm_offset_t hm_shm, hm_pmu, hm_mbox, hm_sysram;
 static LCK_GRP_DECLARE(hm_lck_grp, "herolte_modem");
@@ -173,6 +184,27 @@ hm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unus
 		r->value = *reg;
 		return 0;
 	}
+	if (cmd == HMIO_RADIO) {
+		struct hm_radio *r = (struct hm_radio *)data;
+		if (r->count > 256) {
+			return EINVAL;
+		}
+		void *buf = NULL;
+		if (r->count) {
+			buf = kalloc_data((vm_size_t)r->count * 4096, Z_WAITOK);
+			if (!buf) {
+				return ENOMEM;
+			}
+		}
+		int error = herolte_ufs_read_radio(r->block, r->count, buf, &r->nblocks);
+		if (!error && r->count) {
+			error = copyout(buf, (user_addr_t)r->buffer, (size_t)r->count * 4096);
+		}
+		if (buf) {
+			kfree_data(buf, (vm_size_t)r->count * 4096);
+		}
+		return error;
+	}
 	return ENOTTY;
