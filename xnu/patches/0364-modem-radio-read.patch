@@ -46,6 +48,15 @@ struct hm_reg {
 };
 #define HMIO_SMC        _IOWR('h', 1, struct hm_smc)
 #define HMIO_REG        _IOWR('h', 2, struct hm_reg)
+struct hm_radio {
+	uint64_t block;         /* 4 KiB blocks into the RADIO partition */
+	uint64_t buffer;        /* user address, count * 4096 bytes */
+	uint32_t count;         /* at most 256 (1 MiB); 0 only asks for the size */
+	uint32_t pad;
+	uint64_t nblocks;       /* out: the partition's size in blocks */
+};
+#define HMIO_RADIO      _IOWR('h', 3, struct hm_radio)
