SWEET HID queue diagnosis for the hero2lte UI freeze.

The freeze leaves every backboardd and SpringBoard thread idle in mach_msg
while the kernel keeps dispatching touches and buttons: log, for every
button event and for dropped events, whether the reader still advances the
queue head, how many notifications were sent and whether any send failed.

diff --git a/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.cpp b/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.cpp
--- a/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.cpp
+++ b/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.cpp
@@ -237,8 +237,36 @@
 
 void IOHIDEventServiceQueue::sendDataAvailableNotification()
 {
+    /*
+     * SWEET: IODataQueue::sendDataAvailableNotification() with the result
+     * kept. TIMED_OUT means a notification is already waiting in the port;
+     * NO_BUFFER silently drops it, and the queue then never notifies again
+     * until it is emptied (patch 0329, freeze diagnosis).
+     */
+    mach_msg_header_t * msgh = (mach_msg_header_t *)notifyMsg;	/* IODataQueueInternal starts with it */
+
     _notificationCount++;
-    super::sendDataAvailableNotification();
+    if (msgh && msgh->msgh_remote_port) {
+        kern_return_t kr = mach_msg_send_from_kernel_with_options(msgh, msgh->msgh_size, MACH_SEND_TIMEOUT, MACH_MSG_TIMEOUT_NONE);
+        if (kr != MACH_MSG_SUCCESS && kr != MACH_SEND_TIMED_OUT) {
+            _sweetLastKr = kr;
+            if (_sweetSendFails++ < 8) {
+                IOLog("SWEET HIDQ: %p notification send returned %#x (failure %u)\n", this, kr, _sweetSendFails);
+            }
+        }
+    }
+}
+
+void IOHIDEventServiceQueue::sweetState(UInt32 *head, UInt32 *tail, UInt64 *notes, bool *port, UInt32 *fails, int *lastKr)
+{
+    mach_msg_header_t * msgh = (mach_msg_header_t *)notifyMsg;
+
+    *head = dataQueue ? __c11_atomic_load((_Atomic UInt32 *)&dataQueue->head, __ATOMIC_RELAXED) : 0;
+    *tail = dataQueue ? __c11_atomic_load((_Atomic UInt32 *)&dataQueue->tail, __ATOMIC_RELAXED) : 0;
+    *notes = _notificationCount;
+    *port = msgh && msgh->msgh_remote_port;
+    *fails = _sweetSendFails;
+    *lastKr = _sweetLastKr;
 }
 
