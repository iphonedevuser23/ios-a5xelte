diff --git a/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.h b/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.h
--- a/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.h
+++ b/iokit/Kernel/arm/hid/IOHIDEventServiceQueue.h
@@ -48,6 +48,8 @@
     OSObject                *_owner;
     UInt32                  _options;
     UInt64                  _notificationCount;
+    UInt32                  _sweetSendFails;	/* sends that did not reach the port */
+    int                     _sweetLastKr;
 
     virtual void sendDataAvailableNotification() APPLE_KEXT_OVERRIDE;
 
@@ -68,6 +70,9 @@
     virtual void setNotificationPort(mach_port_t port) APPLE_KEXT_OVERRIDE;
     virtual bool serialize(OSSerialize * serializer) const APPLE_KEXT_OVERRIDE;
 
+    /* SWEET: queue state for the freeze diagnosis (patch 0329). */
+    void sweetState(UInt32 *head, UInt32 *tail, UInt64 *notes, bool *port, UInt32 *fails, int *lastKr);
+
 };
 
