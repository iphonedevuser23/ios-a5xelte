diff --git a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
--- a/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
+++ b/iokit/Kernel/arm/hid/IOHIDEventServiceUserClient.cpp
@@ -637,6 +637,24 @@
             ++_droppedEventCount;
             IOHID_DEBUG(kIOHIDDebugCode_HIDEventServiceEnqueueFail, event->getTimeStampOfType(kIOHIDEventTimestampTypeDefault), event->getOptions() & kIOHIDEventOptionContinuousTime, 0, 0);
         }
+        /*
+         * SWEET (patch 0329): when the UI stops answering, say whether the
+         * reader (backboardd) still takes events out of this queue: head
+         * moves when it reads, tail when we write. Every button event, the
+         * first drops, then every 64th drop.
+         */
+        if (_lastEventType == kIOHIDEventTypeKeyboard || (result == false &&
+            (_droppedEventCount <= 4 || (_droppedEventCount % 64) == 0))) {
+            UInt32 head, tail, fails;
+            UInt64 notes;
+            bool port;
+            int lastKr;
+            _queue->sweetState(&head, &tail, &notes, &port, &fails, &lastKr);
+            IOLog("SWEET HIDQ: %p %s type %u: head %u tail %u events %llu dropped %llu notes %llu port %d send-fails %u (last %#x)\n",
+                _queue, result ? "queued" : "DROPPED", (unsigned)_lastEventType, head, tail,
+                (unsigned long long)_eventCount, (unsigned long long)_droppedEventCount,
+                (unsigned long long)notes, port, fails, lastKr);
+        }
     }
 }
 
