diff --git a/bsd/dev/herolte_touch.c b/bsd/dev/herolte_touch.c
index 0839b8a..8558a13 100644
--- a/bsd/dev/herolte_touch.c
+++ b/bsd/dev/herolte_touch.c
@@ -407,6 +407,123 @@ pm_touch_power_on(void)
 
 static vm_offset_t apm_pmu, apm_mbox;
 
+/*
+ * The APM's firmware. Linux (drivers/mailbox/samsung/mailbox-exynos8.c firmware_update) copies it into the APM SRAM
+ * (0x11200000, 0x40000 bytes) at every boot, from the "APMFW" binary of the ECT's "BIN" block; S-Boot leaves the ECT
+ * in RAM at 0xa0000000 (DTB ect parameter_address, 0x19000 bytes; parser drivers/soc/samsung/ect_parser.c). What a
+ * previous Linux left in the SRAM does not survive every reset: after a forced reset out of iOS into TWRP and back,
+ * the SRAM held garbage (hero2lte boot-2714229636), the M3 never answered and there was no touch supply. So the
+ * firmware is loaded here, as Linux does, while the M3 is still held. Device memory: 32-bit reads, bytes compared
+ * one by one. Boot-arg heroapmload=0 keeps whatever is in the SRAM.
+ */
+#define ECT_PA          0xa0000000u
+#define ECT_SIZE        0x19000u
+#define APM_SRAM_PA     0x11200000u
+#define APM_SRAM_SIZE   0x40000u
+
+static uint32_t
+ect_word(vm_offset_t ect, uint32_t off)
+{
+	return off <= ECT_SIZE - 4 ? *(volatile uint32_t *)(ect + off) : 0;
+}
+
+static bool
+ect_name_is(vm_offset_t ect, uint32_t off, uint32_t len, const char *want)
+{
+	uint32_t n = (uint32_t)strlen(want);
+	if (len != n || off + n > ECT_SIZE) {
+		return false;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if (*(volatile uint8_t *)(ect + off + i) != (uint8_t)want[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ect_parse_string(): a length, then length + 1 bytes padded to 4. Returns the name's offset and length. */
+static bool
+ect_string(uint32_t *off, vm_offset_t ect, uint32_t *name, uint32_t *len)
+{
+	uint32_t l = ect_word(ect, *off);
+	if (l > 64 || *off + 4 + l + 1 > ECT_SIZE) {
+		return false;
+	}
+	*name = *off + 4;
+	*len = l;
+	*off += 4 + ((l + 1 + 3) & ~3u);
+	return true;
+}
+
+static bool
+apm_load_from_ect(void)
+{
+	int enabled = 1;
+	PE_parse_boot_argn("heroapmload", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("HEROLTE APM: firmware load from the ECT disabled (heroapmload=0)\n");
+		return false;
+	}
+	vm_offset_t ect = ml_io_map(ECT_PA, ECT_SIZE);
+	if (!ect) {
+		printf("HEROLTE APM: ECT mapping failed\n");
+		return false;
+	}
+	if (ect_word(ect, 0) != 0x41524150u) {           /* "PARA" */
+		printf("HEROLTE APM: no ECT at %#x (sign %#x): keeping the SRAM as found\n", ECT_PA, ect_word(ect, 0));
+		return false;
+	}
+	uint32_t headers = ect_word(ect, 12), off = 16, name, len;
+	for (uint32_t i = 0; i < headers && i < 32; i++) {
+		if (!ect_string(&off, ect, &name, &len)) {
+			break;
+		}
+		uint32_t block = ect_word(ect, off);
+		off += 4;
+		if (!ect_name_is(ect, name, len, "BIN")) {
+			continue;
+		}
+		/* ect_parse_bin_header(): parser version, version, count, then (name, offset) pairs. */
+		uint32_t count = ect_word(ect, block + 8), p = block + 12;
+		for (uint32_t j = 0; j < count && j < 16; j++) {
+			if (!ect_string(&p, ect, &name, &len)) {
+				break;
+			}
+			uint32_t at = block + ect_word(ect, p);
+			p += 4;
+			if (!ect_name_is(ect, name, len, "APMFW")) {
+				continue;
+			}
+			uint32_t size = ect_word(ect, at), data = at + 4;
+			if (size == 0 || size > APM_SRAM_SIZE || data + size > ECT_SIZE) {
+				printf("HEROLTE APM: ECT APMFW size %u out of range\n", size);
+				return false;
+			}
+			vm_offset_t sram = ml_io_map(APM_SRAM_PA, APM_SRAM_SIZE);
+			if (!sram) {
+				printf("HEROLTE APM: SRAM mapping failed\n");
+				return false;
+			}
+			uint32_t words = (size + 3) / 4, sum = 0, bad = 0;
+			for (uint32_t w = 0; w < words; w++) {
+				uint32_t v = ect_word(ect, data + w * 4);
+				*(volatile uint32_t *)(sram + w * 4) = v;
+				sum += v;
+			}
+			__builtin_arm_dsb(0xf);
+			for (uint32_t w = 0; w < words; w++) {
+				bad += *(volatile uint32_t *)(sram + w * 4) != ect_word(ect, data + w * 4);
+			}
+			printf("HEROLTE APM: firmware from the ECT: %u bytes, sum %#x, %u words differ; SRAM now %08x %08x\n",
+			    size, sum, bad, *(volatile uint32_t *)sram, *(volatile uint32_t *)(sram + 4));
+			return bad == 0;
+		}
+	}
+	printf("HEROLTE APM: no APMFW in the ECT: keeping the SRAM as found\n");
+	return false;
+}
+
 static bool
 apm_start(void)
 {
@@ -421,6 +538,7 @@ apm_start(void)
 		printf("HEROLTE APM: releasing the M3 in 11 s (config=%#x option=%#x)\n",
 		    ht_rd(apm_pmu, APM_CONFIG), opt);
 		ht_checkpoint();
+		(void)apm_load_from_ect();
 		/* exynos8890_apm_power_up() then exynos8890_apm_reset_release(). */
 		ht_wr(apm_pmu, APM_CONFIG, (ht_rd(apm_pmu, APM_CONFIG) & ~1u) | 1u);
 		ht_wr(apm_mbox, MBOX_TX_IRQ0, 0);
